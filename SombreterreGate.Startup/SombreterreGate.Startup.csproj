<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The .NET startup hook the launcher points DOTNET_STARTUP_HOOKS at, so the main menu is the server's
    from the game's very first screen. Shipped inside the client mod's zip, under native/, which the
    game's mod loader skips. See StartupHook.cs.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\SombreterreGate.Client\bin\$(Configuration)\Mods\sombreterregate\native</OutputPath>
        <Nullable>enable</Nullable>
        <AssemblyName>SombreterreGate.Startup</AssemblyName>
        <RootNamespace>SombreterreGate.Client</RootNamespace>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\SombreterreGate.Client\MainMenuPatches.cs" Link="MainMenuPatches.cs" />
        <Compile Include="..\SombreterreGate.Client\GateSession.cs" Link="GateSession.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="VintagestoryAPI">
            <HintPath>$(VINTAGE_STORY_PRE)/VintagestoryAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="VintagestoryLib">
            <HintPath>$(VINTAGE_STORY_PRE)/VintagestoryLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(VINTAGE_STORY_PRE)/Lib/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
